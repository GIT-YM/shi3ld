# Magento core is deployed by Composer; track only this project's overrides.
/magento/*
!/magento/composer.json
!/magento/composer.lock
!/magento/app/
/magento/app/*
!/magento/app/code/
/magento/app/code/*
!/magento/app/code/Shi3ld/
!/magento/app/design/
/magento/app/design/*
!/magento/app/design/frontend/
/magento/app/design/frontend/*
!/magento/app/design/frontend/Shi3ld/
!/magento/app/etc/
/magento/app/etc/*
!/magento/app/etc/config.php
!/magento/bin/
/magento/bin/*
!/magento/bin/shi3ld-apply-patches.php
!/magento/patches/
/laravel/.env
/laravel/storage/*.key
/laravel/storage/app/private/
