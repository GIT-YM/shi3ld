COMPOSE_PROJECT_NAME=shi3ld
LOCAL_UID=1000
LOCAL_GID=1000
PHP_VERSION=8.5
MAGENTO_VERSION=2.4.9
LARAVEL_VERSION=^13.0
SHOP_PORT=9080
SERVICES_PORT=9082
MAIL_PORT=9085
# Per-server hostname: shi3ld.<server>, e.g. shi3ld.gmkserver or shi3ld.rpidevserver.
# bin/init-env fills it from this machine's hostname. nginx, the dev certificate,
# Magento and Laravel all take their URLs from it, so nothing in Git names a server.
SITE_HOST=shi3ld.localhost
SHOP_URL=https://${SITE_HOST}
SERVICES_URL=https://${SITE_HOST}
MYSQL_ROOT_PASSWORD=replace-with-random-local-password
MAGENTO_DB_PASSWORD=replace-with-random-local-password
LARAVEL_DB_PASSWORD=replace-with-random-local-password
MAGENTO_READ_PASSWORD=replace-with-random-local-password
MAGENTO_ADMIN_USER=shi3ld_admin
MAGENTO_ADMIN_PASSWORD=replace-with-strong-local-password
MAGENTO_ADMIN_EMAIL=admin@example.test
