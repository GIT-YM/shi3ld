<?php /** @var \Magento\CatalogWidget\Block\Product\ProductsList $block */ ?>
<?php $products = $block->getProductCollection(); ?>
<?php if ($products && $products->count()): ?>
<div class="featured-products-grid">
<?php foreach ($products as $product): ?>
<article class="product-card"><a href="<?= $block->escapeUrl($block->getProductUrl($product)) ?>"><?= $block->getImage($product, 'category_page_grid')->toHtml() ?><h3><?= $block->escapeHtml($product->getName()) ?></h3></a><?= $block->getProductPrice($product) ?><a class="text-link" href="<?= $block->escapeUrl($block->getProductUrl($product)) ?>">View specifications ↗</a></article>
<?php endforeach; ?>
</div>
<?php else: ?>
<p>The product catalogue is being prepared.</p>
<?php endif; ?>
<?php if ($block->showPager()): ?><?= $block->getPagerHtml() ?><?php endif; ?>
