<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="shi3ld_blog_post" resource="default" engine="innodb" comment="Shi3ld blog articles">
        <column xsi:type="int" name="post_id" unsigned="true" nullable="false" identity="true" />
        <column xsi:type="varchar" name="title" length="255" nullable="false" />
        <column xsi:type="varchar" name="slug" length="180" nullable="false" />
        <column xsi:type="mediumtext" name="content" nullable="false" />
        <column xsi:type="text" name="excerpt" nullable="true" />
        <column xsi:type="varchar" name="featured_image" length="512" nullable="false" default="" />
        <column xsi:type="varchar" name="featured_alt" length="300" nullable="false" default="" />
        <column xsi:type="varchar" name="author" length="150" nullable="false" default="" />
        <column xsi:type="varchar" name="meta_title" length="255" nullable="false" default="" />
        <column xsi:type="text" name="meta_description" nullable="true" />
        <column xsi:type="boolean" name="is_published" nullable="false" default="0" />
        <column xsi:type="boolean" name="is_featured" nullable="false" default="0" />
        <column xsi:type="timestamp" name="published_at" nullable="true" on_update="false" />
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" />
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" />
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="post_id" />
        </constraint>
        <constraint xsi:type="unique" referenceId="SHI3LD_BLOG_POST_SLUG">
            <column name="slug" />
        </constraint>
        <index referenceId="SHI3LD_BLOG_POST_PUBLISHED" indexType="btree">
            <column name="is_published" />
            <column name="published_at" />
        </index>
        <column xsi:type="int" name="author_id" nullable="true" unsigned="true" />
        <column xsi:type="mediumtext" name="editorial" nullable="true" />
        <index referenceId="SHI3LD_BLOG_POST_AUTHOR_ID" indexType="btree">
            <column name="author_id" />
        </index>
        <index referenceId="SHI3LD_BLOG_POST_UPDATED_AT" indexType="btree">
            <column name="updated_at" />
        </index>
    </table>
    <table name="shi3ld_blog_category" resource="default" engine="innodb" comment="Shi3ld editorial categories">
        <column xsi:type="int" name="category_id" unsigned="true" nullable="false" identity="true" />
        <column xsi:type="varchar" name="title" length="255" nullable="false" />
        <column xsi:type="varchar" name="slug" length="180" nullable="false" />
        <column xsi:type="text" name="description" nullable="true" />
        <column xsi:type="varchar" name="meta_title" length="255" nullable="false" default="" />
        <column xsi:type="text" name="meta_description" nullable="true" />
        <column xsi:type="boolean" name="is_active" nullable="false" default="1" />
        <column xsi:type="int" name="position" nullable="false" default="0" />
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" />
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="category_id" />
        </constraint>
        <constraint xsi:type="unique" referenceId="SHI3LD_BLOG_CATEGORY_SLUG">
            <column name="slug" />
        </constraint>
        <column xsi:type="int" name="parent_id" nullable="true" unsigned="true" />
    </table>
    <table name="shi3ld_blog_post_category" resource="default" engine="innodb" comment="Shi3ld article category assignments">
        <column xsi:type="int" name="post_id" unsigned="true" nullable="false" />
        <column xsi:type="int" name="category_id" unsigned="true" nullable="false" />
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="post_id" />
            <column name="category_id" />
        </constraint>
        <constraint xsi:type="foreign" referenceId="SHI3LD_BLOG_ASSIGNMENT_POST" table="shi3ld_blog_post_category" column="post_id" referenceTable="shi3ld_blog_post" referenceColumn="post_id" onDelete="CASCADE" />
        <constraint xsi:type="foreign" referenceId="SHI3LD_BLOG_ASSIGNMENT_CATEGORY" table="shi3ld_blog_post_category" column="category_id" referenceTable="shi3ld_blog_category" referenceColumn="category_id" onDelete="CASCADE" />
        <index referenceId="SHI3LD_BLOG_ASSIGNMENT_CATEGORY_INDEX" indexType="btree">
            <column name="category_id" />
        </index>
    </table>
    <table name="shi3ld_blog_author" resource="default" engine="innodb" comment="Shi3ld blog author">
        <column xsi:type="int" name="author_id" nullable="false" unsigned="true" identity="true" />
        <column xsi:type="varchar" name="name" nullable="false" length="150" />
        <column xsi:type="varchar" name="slug" nullable="false" length="180" />
        <column xsi:type="varchar" name="image" nullable="false" length="512" default="" />
        <column xsi:type="varchar" name="expertise" nullable="false" length="300" default="" />
        <column xsi:type="text" name="biography" nullable="true" />
        <column xsi:type="boolean" name="is_active" nullable="false" default="1" />
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" />
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="author_id" />
        </constraint>
        <constraint xsi:type="unique" referenceId="SHI3LD_BLOG_AUTHOR_SLUG">
            <column name="slug" />
        </constraint>
    </table>
    <table name="shi3ld_blog_tag" resource="default" engine="innodb" comment="Shi3ld blog tag">
        <column xsi:type="int" name="tag_id" nullable="false" unsigned="true" identity="true" />
        <column xsi:type="varchar" name="name" nullable="false" length="100" />
        <column xsi:type="varchar" name="slug" nullable="false" length="180" />
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" />
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="tag_id" />
        </constraint>
        <constraint xsi:type="unique" referenceId="SHI3LD_BLOG_TAG_SLUG">
            <column name="slug" />
        </constraint>
    </table>
    <table name="shi3ld_blog_post_tag" resource="default" engine="innodb" comment="Shi3ld blog post tag">
        <column xsi:type="int" name="post_id" nullable="false" unsigned="true" />
        <column xsi:type="int" name="tag_id" nullable="false" unsigned="true" />
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="post_id" />
            <column name="tag_id" />
        </constraint>
        <index referenceId="SHI3LD_BLOG_POST_TAG_TAG_ID" indexType="btree">
            <column name="tag_id" />
        </index>
    </table>
    <table name="shi3ld_blog_translation" resource="default" engine="innodb" comment="Shi3ld blog translation">
        <column xsi:type="int" name="translation_id" nullable="false" unsigned="true" identity="true" />
        <column xsi:type="varchar" name="entity_type" nullable="false" length="12" />
        <column xsi:type="int" name="entity_id" nullable="false" unsigned="true" />
        <column xsi:type="int" name="store_id" nullable="false" unsigned="true" />
        <column xsi:type="varchar" name="slug" nullable="false" length="180" />
        <column xsi:type="mediumtext" name="payload" nullable="false" />
        <column xsi:type="boolean" name="is_published" nullable="false" default="0" />
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" />
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="translation_id" />
        </constraint>
        <constraint xsi:type="unique" referenceId="SHI3LD_BLOG_TRANSLATION_ENTITY_TYPE_ENTITY_ID_STORE_ID">
            <column name="entity_type" />
            <column name="entity_id" />
            <column name="store_id" />
        </constraint>
        <constraint xsi:type="unique" referenceId="SHI3LD_BLOG_TRANSLATION_ENTITY_TYPE_STORE_ID_SLUG">
            <column name="entity_type" />
            <column name="store_id" />
            <column name="slug" />
        </constraint>
    </table>
    <table name="shi3ld_blog_presence" resource="default" engine="innodb" comment="Shi3ld blog presence">
        <column xsi:type="int" name="post_id" nullable="false" unsigned="true" />
        <column xsi:type="int" name="actor_id" nullable="false" unsigned="true" />
        <column xsi:type="varchar" name="actor" nullable="false" length="150" />
        <column xsi:type="timestamp" name="expires_at" nullable="false" on_update="false" />
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="post_id" />
            <column name="entity_type" />
        </constraint>
        <column xsi:type="varchar" name="entity_type" length="12" nullable="false" default="article" />
    </table>
    <table name="shi3ld_blog_note" resource="default" engine="innodb" comment="Shi3ld blog note">
        <column xsi:type="int" name="note_id" nullable="false" unsigned="true" identity="true" />
        <column xsi:type="int" name="post_id" nullable="false" unsigned="true" />
        <column xsi:type="varchar" name="actor" nullable="false" length="150" />
        <column xsi:type="text" name="body" nullable="false" />
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" />
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="note_id" />
        </constraint>
    </table>
    <table name="shi3ld_blog_feedback" resource="default" engine="innodb" comment="Shi3ld blog feedback">
        <column xsi:type="int" name="feedback_id" nullable="false" unsigned="true" identity="true" />
        <column xsi:type="int" name="post_id" nullable="false" unsigned="true" />
        <column xsi:type="int" name="store_id" nullable="false" unsigned="true" />
        <column xsi:type="varchar" name="kind" nullable="false" length="12" />
        <column xsi:type="varchar" name="name" nullable="false" length="100" default="" />
        <column xsi:type="text" name="body" nullable="true" />
        <column xsi:type="varchar" name="status" nullable="false" length="15" default="pending" />
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" />
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="feedback_id" />
        </constraint>
        <index referenceId="SHI3LD_BLOG_FEEDBACK_STATUS_CREATED_AT" indexType="btree">
            <column name="status" />
            <column name="created_at" />
        </index>
    </table>
    <table name="shi3ld_blog_subscriber" resource="default" engine="innodb" comment="Shi3ld blog subscriber">
        <column xsi:type="int" name="subscriber_id" nullable="false" unsigned="true" identity="true" />
        <column xsi:type="varchar" name="email" nullable="false" length="254" />
        <column xsi:type="varchar" name="email_hash" nullable="false" length="64" />
        <column xsi:type="int" name="store_id" nullable="false" unsigned="true" />
        <column xsi:type="text" name="category_ids" nullable="true" />
        <column xsi:type="varchar" name="status" nullable="false" length="15" default="pending" />
        <column xsi:type="varchar" name="token_hash" nullable="false" length="64" />
        <column xsi:type="timestamp" name="token_expires" nullable="true" on_update="false" />
        <column xsi:type="timestamp" name="last_digest_at" nullable="true" on_update="false" />
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" />
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="subscriber_id" />
        </constraint>
        <constraint xsi:type="unique" referenceId="SHI3LD_BLOG_SUBSCRIBER_EMAIL_HASH_STORE_ID">
            <column name="email_hash" />
            <column name="store_id" />
        </constraint>
        <index referenceId="SHI3LD_BLOG_SUBSCRIBER_STATUS_LAST_DIGEST_AT" indexType="btree">
            <column name="status" />
            <column name="last_digest_at" />
        </index>
    </table>
    <table name="shi3ld_blog_metric" resource="default" engine="innodb" comment="Shi3ld blog metric">
        <column xsi:type="int" name="post_id" nullable="false" unsigned="true" />
        <column xsi:type="date" name="day" nullable="false" />
        <column xsi:type="varchar" name="event" nullable="false" length="20" />
        <column xsi:type="int" name="total" nullable="false" default="0" unsigned="true" />
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="post_id" />
            <column name="day" />
            <column name="event" />
        </constraint>
    </table>
    <table name="shi3ld_blog_guard" resource="default" engine="innodb" comment="Shi3ld blog guard">
        <column xsi:type="varchar" name="guard_key" nullable="false" length="64" />
        <column xsi:type="int" name="hits" nullable="false" default="1" unsigned="true" />
        <column xsi:type="timestamp" name="expires_at" nullable="false" on_update="false" />
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="guard_key" />
        </constraint>
    </table>
    <table name="shi3ld_blog_setting" resource="default" engine="innodb" comment="Shi3ld blog setting">
        <column xsi:type="varchar" name="name" nullable="false" length="60" />
        <column xsi:type="mediumtext" name="value" nullable="false" />
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" />
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="name" />
        </constraint>
    </table>
    <table name="shi3ld_blog_mail" resource="default" engine="innodb" comment="Shi3ld blog mail">
        <column xsi:type="int" name="mail_id" nullable="false" unsigned="true" identity="true" />
        <column xsi:type="int" name="subscriber_id" nullable="false" unsigned="true" />
        <column xsi:type="varchar" name="kind" nullable="false" length="20" />
        <column xsi:type="varchar" name="dedupe_key" nullable="false" length="64" />
        <column xsi:type="mediumtext" name="payload" nullable="false" />
        <column xsi:type="varchar" name="state" nullable="false" length="15" default="queued" />
        <column xsi:type="smallint" name="attempts" nullable="false" default="0" unsigned="true" />
        <column xsi:type="timestamp" name="next_attempt_at" nullable="false" on_update="false" />
        <column xsi:type="timestamp" name="sent_at" nullable="true" on_update="false" />
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" />
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="mail_id" />
        </constraint>
        <constraint xsi:type="unique" referenceId="SHI3LD_BLOG_MAIL_DEDUPE_KEY">
            <column name="dedupe_key" />
        </constraint>
        <index referenceId="SHI3LD_BLOG_MAIL_STATE_NEXT_ATTEMPT_AT" indexType="btree">
            <column name="state" />
            <column name="next_attempt_at" />
        </index>
    </table>
</schema>
