<?php /** @var \Shi3ld\Blog\Block\Adminhtml\Manage $block */ $category = $block->selectedCategory(); ?>
<link rel="stylesheet" href="/services/assets/blog-admin.css?v=20261021.3">
<div class="message message-notice"><div>Blog categories are separate from shop categories. Categories can contain multiple articles; articles can belong to several categories. Disabling a category hides its page and links while preserving its assignments.</div></div>
<div class="blog-admin-actions"><a href="<?= $block->escapeUrl($block->getUrl('shi3ld_blog/article/index')) ?>">← Blog articles</a><a href="<?= $block->escapeUrl($block->getUrl('*/*/index')) ?>">New category</a></div>
<div class="blog-admin-columns"><form class="blog-admin-form" method="post" action="<?= $block->escapeUrl($block->getUrl('shi3ld_blog/category/save')) ?>"><h2><?= $category ? 'Edit category' : 'New category' ?></h2><input type="hidden" name="form_key" value="<?= $block->escapeHtmlAttr($block->csrf()) ?>"><input type="hidden" name="id" value="<?= (int) ($category['category_id'] ?? 0) ?>"><input type="hidden" name="fingerprint" value="<?= $block->escapeHtmlAttr($category ? $block->categoryFingerprint($category) : '') ?>">
<?php foreach (['title' => ['Title',255], 'slug' => ['URL key (generated from title if empty)',180], 'description' => ['Description',5000], 'meta_title' => ['SEO title',255], 'meta_description' => ['SEO description',1000]] as $key => [$label,$max]): ?><label><?= $block->escapeHtml($label) ?><?php if (str_contains($key, 'description')): ?><textarea name="<?= $block->escapeHtmlAttr($key) ?>" maxlength="<?= $max ?>" rows="4"><?= $block->escapeHtml($category[$key] ?? '') ?></textarea><?php else: ?><input name="<?= $block->escapeHtmlAttr($key) ?>" value="<?= $block->escapeHtmlAttr($category[$key] ?? '') ?>" maxlength="<?= $max ?>" <?= $key === 'title' ? 'required' : '' ?>><?php endif; ?></label><?php endforeach; ?>
<label>Parent category<select name="parent_id"><option value="0">No parent</option><?php foreach($block->categories() as $parent): ?><?php if((int)$parent['category_id']===(int)($category['category_id'] ?? 0)){continue;} ?><option value="<?= (int)$parent['category_id'] ?>" <?= (int)($category['parent_id'] ?? 0)===(int)$parent['category_id'] ? 'selected' : '' ?>><?= $block->escapeHtml($parent['title']) ?></option><?php endforeach; ?></select></label>
<label>Sort position <input type="number" name="position" min="0" max="10000" value="<?= (int) ($category['position'] ?? 0) ?>"></label><label><input type="checkbox" name="is_active" value="1" <?= !$category || $category['is_active'] ? 'checked' : '' ?>> Active</label><p>Changing a saved URL key creates a permanent redirect. Article URLs stay unchanged.</p><button class="action-primary" type="submit">Save category</button></form>
<div class="blog-admin-table"><table class="data-grid"><thead><tr><th class="data-grid-th">Category</th><th class="data-grid-th">URL</th><th class="data-grid-th">Status</th></tr></thead><tbody><?php foreach ($block->categories() as $row): ?><tr><td><a href="<?= $block->escapeUrl($block->getUrl('*/*/index', ['id' => $row['category_id']])) ?>"><?= $block->escapeHtml($row['title']) ?></a></td><td>/blog/category/<?= $block->escapeHtml($row['slug']) ?></td><td><?= $row['is_active'] ? 'Active' : 'Hidden' ?></td></tr><?php endforeach; ?></tbody></table></div></div>
