<?php /** @var \Shi3ld\Blog\Block\Adminhtml\Manage $block */ $listing = $block->listing(); $number = max(1, (int) $block->getRequest()->getParam('p', 1)); ?>
<link rel="stylesheet" href="/services/assets/blog-admin.css?v=20261021.3">
<div class="message message-notice"><div>Create an article, then use its visual editor to add sections, choose categories and a featured image, save drafts and publish. Published URLs are generated automatically and remain stable when titles change.</div></div>
<div class="blog-admin-actions"><a href="<?= $block->escapeUrl($block->getUrl('shi3ld_blog/category/index')) ?>">Manage blog categories</a><a href="<?= $block->escapeUrl($block->getUrl('shi3ld_blog/widget/index')) ?>">Build an article widget / shortcode</a></div>
<form class="blog-admin-create" method="post" action="<?= $block->escapeUrl($block->getUrl('shi3ld_blog/article/create')) ?>"><input type="hidden" name="form_key" value="<?= $block->escapeHtmlAttr($block->csrf()) ?>"><label for="blog-new-title">New article title</label><input id="blog-new-title" name="title" maxlength="255" required placeholder="Enter your article title"><button class="action-primary" type="submit">Create draft & open visual editor</button></form>
<form class="blog-admin-filters" method="get" action="<?= $block->escapeUrl($block->getUrl('*/*/index')) ?>"><label>Search title <input type="search" name="q" value="<?= $block->escapeHtmlAttr($block->search()) ?>" maxlength="100"></label><label>Status <select name="status"><option value="">All</option><option value="1" <?= $block->getRequest()->getParam('status') === '1' ? 'selected' : '' ?>>Published</option><option value="0" <?= $block->getRequest()->getParam('status') === '0' ? 'selected' : '' ?>>Unpublished</option></select></label><label>Category <select name="category"><option value="0">All categories</option><?php foreach ($block->categories() as $category): ?><option value="<?= (int) $category['category_id'] ?>" <?= (int) $block->getRequest()->getParam('category') === (int) $category['category_id'] ? 'selected' : '' ?>><?= $block->escapeHtml($category['title']) ?></option><?php endforeach; ?></select></label><button type="submit">Filter</button></form>
<p><?= (int) $listing['total'] ?> article(s). Categories shown here reflect the published version; draft assignments are in the visual editor.</p>
<div class="blog-admin-table"><table class="data-grid"><thead><tr><th class="data-grid-th">ID</th><th class="data-grid-th">Article</th><th class="data-grid-th">Status</th><th class="data-grid-th">Published</th><th class="data-grid-th">Actions</th></tr></thead><tbody>
<?php foreach ($listing['items'] as $post): ?><tr><td><?= (int) $post['post_id'] ?></td><td><strong><?= $block->escapeHtml($post['title']) ?></strong><br><small>/blog/<?= $block->escapeHtml($post['slug']) ?></small><?php if ($post['is_featured']): ?> · Featured<?php endif; ?></td><td><?= $post['is_published'] ? 'Published' : 'Unpublished' ?></td><td><?= $block->escapeHtml($post['published_at'] ?: '—') ?></td><td><a href="<?= $block->escapeUrl($block->getUrl('shi3ld_content/editor/index', ['type' => 'article','id' => $post['post_id']])) ?>">Open visual editor</a><?php if ($post['is_published'] && $block->canPublish()): ?><form method="post" action="<?= $block->escapeUrl($block->getUrl('shi3ld_blog/article/unpublish')) ?>"><input type="hidden" name="form_key" value="<?= $block->escapeHtmlAttr($block->csrf()) ?>"><input type="hidden" name="id" value="<?= (int) $post['post_id'] ?>"><input type="hidden" name="fingerprint" value="<?= $block->escapeHtmlAttr($block->fingerprint((int) $post['post_id'])) ?>"><button type="submit" class="action-secondary">Unpublish</button></form><?php endif; ?></td></tr><?php endforeach; ?>
<?php if (!$listing['items']): ?><tr><td colspan="5">No articles yet. Create your first draft above.</td></tr><?php endif; ?>
</tbody></table></div>
<div class="blog-admin-actions"><?php if ($number > 1): ?><a href="<?= $block->escapeUrl($block->getUrl('*/*/index', ['_current' => true, 'p' => $number - 1])) ?>">← Previous</a><?php endif; ?><?php if ($number * 25 < $listing['total']): ?><a href="<?= $block->escapeUrl($block->getUrl('*/*/index', ['_current' => true, 'p' => $number + 1])) ?>">Next →</a><?php endif; ?></div>
