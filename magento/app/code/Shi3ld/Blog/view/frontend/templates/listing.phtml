<?php /** @var \Shi3ld\Blog\Block\Blog $block */ $page = $block->page(); $pages = max(1, (int) ceil($page->listing['total'] / 12)); ?>
<div class="blog-page">
    <header class="blog-hero container">
        <nav class="blog-breadcrumbs" aria-label="Breadcrumb"><a href="<?= $block->escapeUrl($block->getUrl('')) ?>">Home</a><span aria-hidden="true">/</span><?php if ($page->category): ?><a href="<?= $block->escapeUrl($block->getUrl('', ['_direct' => 'blog'])) ?>">Advice & resources</a><span aria-hidden="true">/</span><span><?= $block->escapeHtml($page->category['title']) ?></span><?php else: ?><span>Advice & resources</span><?php endif; ?></nav>
        <p class="eyebrow">THE SHI3LD JOURNAL</p><h1><?= $block->escapeHtml($page->category['title'] ?? $page->author['name'] ?? ($page->tag ? 'Topic: '.$page->tag['name'] : 'Advice & resources')) ?></h1>
        <p class="blog-introduction"><?= $block->escapeHtml($page->category['description'] ?? $page->author['biography'] ?? 'Helpful ideas for accessible spaces, thoughtful cleaning and everyday care.') ?></p>
        <?php if($page->author): ?><div class="blog-author-summary"><?php if($page->author['image']): ?><img src="<?= $block->escapeUrl($block->image(['featured_image'=>$page->author['image']],320)) ?>" alt="<?= $block->escapeHtmlAttr($page->author['name']) ?>" width="96" height="96"><?php endif; ?><p><?= $block->escapeHtml($page->author['expertise']) ?></p></div><?php endif; ?>
    </header>
    <div class="container">
        <div class="blog-filter-bar"><nav class="blog-category-nav" aria-label="Article categories"><a href="<?= $block->escapeUrl($block->getUrl('', ['_direct' => 'blog'])) ?>" <?= !$page->category ? 'aria-current="page"' : '' ?>>All articles</a><?php foreach ($block->categories() as $category): ?><a href="<?= $block->escapeUrl($block->categoryUrl($category)) ?>" <?= ($page->category['category_id'] ?? null) === $category['category_id'] ? 'aria-current="page"' : '' ?>><?= $block->escapeHtml($category['title']) ?></a><?php endforeach; ?></nav>
        <form class="blog-search blog-advanced-search" method="get" action="<?= $block->escapeUrl($block->getUrl('',['_direct'=>'blog'])) ?>">
<label for="blog-search">Search articles<input id="blog-search" type="search" name="q" value="<?= $block->escapeHtmlAttr($page->search) ?>" maxlength="100" placeholder="Search titles and article text"></label>
<label>Category<select name="c"><option value="0">All categories</option><?php foreach($block->categories() as $category): ?><option value="<?= (int)$category['category_id'] ?>" <?= (int)($page->filters['c'] ?? $page->category['category_id'] ?? 0)===(int)$category['category_id'] ? 'selected' : '' ?>><?= $block->escapeHtml(($category['parent_id'] ? '↳ ' : '').$category['title']) ?></option><?php endforeach; ?></select></label>
<label>Author<select name="a"><option value="0">All authors</option><?php foreach($block->authors() as $author): ?><option value="<?= (int)$author['author_id'] ?>" <?= (int)($page->filters['a'] ?? $page->author['author_id'] ?? 0)===(int)$author['author_id'] ? 'selected' : '' ?>><?= $block->escapeHtml($author['name']) ?></option><?php endforeach; ?></select></label>
<label>Topic<select name="t"><option value="0">All topics</option><?php foreach($block->tags() as $tag): ?><option value="<?= (int)$tag['tag_id'] ?>" <?= (int)($page->filters['t'] ?? $page->tag['tag_id'] ?? 0)===(int)$tag['tag_id'] ? 'selected' : '' ?>><?= $block->escapeHtml($tag['name']) ?></option><?php endforeach; ?></select></label>
<label>From<input type="date" name="from" value="<?= $block->escapeHtmlAttr($page->filters['from'] ?? '') ?>"></label><label>To<input type="date" name="to" value="<?= $block->escapeHtmlAttr($page->filters['to'] ?? '') ?>"></label>
<label>Order<select name="sort"><?php foreach(['newest'=>'Newest first','oldest'=>'Oldest first','relevance'=>'Relevance'] as $value=>$label): ?><option value="<?= $value ?>" <?= ($page->filters['sort'] ?? 'newest')===$value ? 'selected' : '' ?>><?= $label ?></option><?php endforeach; ?></select></label><button class="button button-small" type="submit">Apply filters</button><a href="<?= $block->escapeUrl($block->getUrl('',['_direct'=>'blog'])) ?>">Clear filters</a></form></div>
        <?php if ($page->search !== ''): ?><p class="blog-results" role="status"><?= (int) $page->listing['total'] ?> result(s) for “<?= $block->escapeHtml($page->search) ?>”</p><?php endif; ?>
        <?php if ($block->articles()): ?><?= /* @noEscape */ $block->cards() ?><?php else: ?><section class="blog-empty"><h2><?= $page->search !== '' ? 'No matching articles' : 'Articles are on their way' ?></h2><p><?= $page->search !== '' ? 'Try another title or browse a different category.' : 'Visit again for new advice and resources from Shi3ld Alliance.' ?></p></section><?php endif; ?>
        <?php if ($pages > 1): ?><nav class="blog-pagination" aria-label="Article pages"><?php if ($page->page > 1): ?><a rel="prev" href="<?= $block->escapeUrl($block->pageUrl($page->page - 1)) ?>">← Previous</a><?php endif; ?><?php for ($number = max(1, $page->page - 2); $number <= min($pages, $page->page + 2); $number++): ?><a href="<?= $block->escapeUrl($block->pageUrl($number)) ?>" <?= $number === $page->page ? 'aria-current="page"' : '' ?>><?= $number ?></a><?php endfor; ?><?php if ($page->page < $pages): ?><a rel="next" href="<?= $block->escapeUrl($block->pageUrl($page->page + 1)) ?>">Next →</a><?php endif; ?></nav><?php endif; ?>
        <?= /* @noEscape */ $block->subscription() ?>
