<?php /** @var \Shi3ld\Content\Block\Site $block */ ?>
<section class="container information-hero"><?= $block->cms('shi3ld_shop_intro') ?></section>
<section class="section-topless container">
<?php $categories = $block->getShopCategories(); ?>
<?php if ($categories->getSize()): ?>
<nav aria-label="Product categories"><p class="eyebrow">Browse by category</p><div class="button-row">
<?php foreach ($categories as $category): ?>
<a class="button button-outline" href="<?= $block->escapeUrl($category->getUrl()) ?>"><?= $block->escapeHtml($category->getName()) ?></a>
<?php endforeach; ?>
</div></nav>
<?php endif; ?>
<?php $products = $block->getProducts(24, true); $pager = $block->pager($products); ?>
<?php if ($products->getSize()): ?>
<div class="featured-products-grid"><?php foreach ($products as $product): ?><article class="product-card"><a href="<?= $block->escapeUrl($block->getProductUrl($product)) ?>"><?= $block->getImage($product, 'category_page_grid')->toHtml() ?><h2><?= $block->escapeHtml($product->getName()) ?></h2></a><?= $block->getProductPrice($product) ?><a class="text-link" href="<?= $block->escapeUrl($block->getProductUrl($product)) ?>">View product ↗</a></article><?php endforeach; ?></div>
<?= $pager ?>
<?php else: ?><div class="empty-state"><h2>The catalogue is being prepared.</h2><p>Approved products, specifications, images and pricing will be added here.<br>Cleaning service enquiries are available now.</p><a class="button" href="<?= $block->escapeUrl($block->getUrl('', ['_direct' => 'services'])) ?>">Explore cleaning services ↗</a></div><?php endif; ?>
</section>
