    <p class="message"><?= $block->escapeHtml($block->getData('offline_message')) ?></p>
    <a class="login" href="<?= $block->escapeUrl($block->getData('admin_url')) ?>">Administrator sign in</a>
    <p class="note"><?= $block->getData('automatic_preview') ? 'Administrators can sign in to view the website automatically in this browser.' : 'Administrators can sign in and open a private website preview.' ?></p>
