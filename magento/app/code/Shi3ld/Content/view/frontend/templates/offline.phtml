<?php if ($block->getData('automatic_preview')): ?>
<main id="site-access-check" role="status" aria-live="polite">
    <p class="brand">Shi3ld Alliance</p>
    <h1>Loading website…</h1>
    <p class="message">Please wait a moment.</p>
</main>
<script nonce="<?= $block->escapeHtmlAttr($block->getData('script_nonce')) ?>">
(function () {
    'use strict';
    var showOffline = function () {
        document.documentElement.classList.remove('shi3ld-checking-access');
    };
    if (!window.fetch || !window.AbortController) {
        showOffline();
        return;
    }
    var controller = new AbortController();
    var timeout = window.setTimeout(function () {
        controller.abort();
        showOffline();
    }, 10000);
    var options = {
        method: 'GET',
        credentials: 'same-origin',
        cache: 'no-store',
        redirect: 'error',
        headers: {'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest'},
        signal: controller.signal
    };
    fetch(<?= /* @noEscape */ json_encode($block->getData('admin_preview_url'), JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>, options)
        .then(function (response) {
            if (!response.ok) {
                throw new Error('Administrator access unavailable');
            }
            return response.json();
        })
        .then(function (result) {
            if (result.allowed !== true) {
                throw new Error('Administrator sign-in required');
            }
            // Confirm the browser accepted the preview cookie before reloading.
            return fetch('/site-preview/access/check/', options);
        })
        .then(function (response) {
            if (response.status !== 204) {
                throw new Error('Administrator access unavailable');
            }
            window.location.reload();
        })
        .catch(showOffline)
        .finally(function () { window.clearTimeout(timeout); });
}());
</script>
<?php endif; ?>
</body>
</html>
