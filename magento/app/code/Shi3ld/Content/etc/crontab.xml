<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="shi3ld_builder_publish_due" instance="Shi3ld\Content\Model\Builder\Workflow" method="run"><schedule>* * * * *</schedule></job>
        <job name="shi3ld_site_sitemaps" instance="Shi3ld\Content\Model\SiteSitemaps" method="generate">
            <schedule>0 2 * * *</schedule>
        </job>
    </group>
</config>
